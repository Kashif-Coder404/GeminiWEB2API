# Gemini Web to OpenAI API Proxy Environment Variables
# Used locally, with Docker, and on Cloud platforms (Render, Railway, Fly.io)

# Your Google Gemini Cookie string (required for Pro models and bypass rate-limiting)
# Format: "SSID=...; SAPISID=...; __Secure-1PSID=...;"
COOKIE=

# Google Gemini Web XSRF/CSRF Token (from gemini-auth.json or browser network tab "at" parameter)
# Prevents HTTP 400 Bad Request
XSRF_TOKEN=

# Google Gemini Web Build Label (from gemini-auth.json or browser page source)
# Example: "boq_gemini-web-uiserver_20260927.05_p0"
GEMINI_BL=

# Optional: Port (Render automatically sets this dynamically)
PORT=8081

# Optional: Path to cookie file if using a file instead of raw string
# COOKIE_FILE=gemini-auth.json

# Optional: HTTP/HTTPS Proxy (e.g. http://127.0.0.1:7890)
# PROXY=
